{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-pipeline.local/schemas/artifacts/progress.schema.json",
  "title": "Producer or streaming progress artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifact_type", "schema_version", "run_id", "updated_at", "state", "records"],
  "properties": {
    "artifact_type": {"enum": ["producer-progress", "streaming-progress"]},
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "state": {"type": "string"},
    "records": {"type": "integer", "minimum": 0}
  }
}
