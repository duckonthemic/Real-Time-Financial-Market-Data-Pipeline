{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-pipeline.local/schemas/artifacts/failure.schema.json",
  "title": "Failure artifact",
  "type": "object",
  "additionalProperties": false,
  "required": ["artifact_type", "schema_version", "run_id", "updated_at", "category", "message", "failed_phase", "remediation", "cleanup_errors"],
  "properties": {
    "artifact_type": {"const": "failure"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string"},
    "updated_at": {"type": "string", "format": "date-time"},
    "category": {"enum": ["CONFIGURATION", "INFRASTRUCTURE", "INVARIANT", "TIMEOUT", "UNEXPECTED"]},
    "message": {"type": "string", "maxLength": 1000},
    "failed_phase": {"type": "string"},
    "remediation": {"type": "string"},
    "cleanup_errors": {"type": "array", "items": {"type": "string"}}
  }
}
