{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://market-pipeline.local/schemas/artifacts/run.schema.json",
  "title": "Run artifact",
  "type": "object",
  "additionalProperties": true,
  "required": ["artifact_type", "schema_version", "run_id", "updated_at", "state", "scenario"],
  "properties": {
    "artifact_type": {"const": "run"},
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{7,63}$"},
    "updated_at": {"type": "string", "format": "date-time"},
    "state": {"enum": ["CREATED", "INFRA_READY", "RUN_READY", "PRODUCING", "FAILURE_INJECTED", "RECOVERING", "VERIFYING", "PASSED", "FAILED", "TIMED_OUT"]},
    "scenario": {"enum": ["standard", "recovery-showcase"]}
  }
}
